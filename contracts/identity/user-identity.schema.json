{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olive.invalid/contracts/identity/user-identity.schema.json",
  "title": "user identity mapping fixture (Olive-proposed; D-06)",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "on_behalf_of", "oid", "tid"],
  "properties": {
    "tenant_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "on_behalf_of": { "type": "string", "minLength": 1 },
    "oid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "tid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
  }
}
