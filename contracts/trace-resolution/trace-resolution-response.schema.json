{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olive.invalid/contracts/trace-resolution/trace-resolution-response.schema.json",
  "title": "hometown trace resolution response (fixture contract, Olive-proposed; Q20 pending)",
  "type": "object",
  "additionalProperties": false,
  "required": ["trace_id", "schema_version", "run_id", "tenant_id", "agent_id", "proposal_hash", "created_at"],
  "properties": {
    "trace_id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "pattern": "^ate/[0-9]+\\.[0-9]+$" },
    "run_id": { "type": ["string", "null"] },
    "tenant_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "agent_id": { "type": ["string", "null"] },
    "proposal_hash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
