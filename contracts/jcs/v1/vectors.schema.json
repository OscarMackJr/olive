{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://olive.invalid/contracts/jcs/v1/vectors.schema.json",
  "title": "Olive JCS golden vector manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "cases"],
  "properties": {
    "version": {"const": 1},
    "source": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "input", "gate"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "kind": {"enum": ["body", "proposal_hash"]},
          "input": {"type": "string", "pattern": "\\.input\\.json$"},
          "canonical": {"type": "string", "pattern": "\\.canonical\\.json$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "gate": {"enum": ["accept", "reject_lossy_number", "reject_duplicate_key", "reject_lone_surrogate"]},
          "expect": {"const": "reject"},
          "reason": {"type": "string"}
        },
        "if": {"required": ["expect"]},
        "then": {"not": {"anyOf": [{"required": ["canonical"]}, {"required": ["sha256"]}]}},
        "else": {"required": ["canonical", "sha256"]}
      }
    }
  }
}
