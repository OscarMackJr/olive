# Copy to .env (gitignored) for local runs. Never commit secrets.
#
# OLIVE_MIGRATOR_URL is read ONLY by the migrator command, from the SHELL
# environment. It must NEVER be placed in this file: the service refuses to
# start when it is set.
#
# The service reads only OLIVE_POSTGRES_URL; the split variables below exist
# for tooling parity.
OLIVE_ENVIRONMENT=local
OLIVE_POSTGRES_URL=postgresql://olive_app:CHANGE_ME_LOCAL_ONLY@localhost:5432/olive
OLIVE_POSTGRES_HOST=localhost
OLIVE_POSTGRES_PORT=5432
OLIVE_POSTGRES_DB=olive
OLIVE_POSTGRES_USER=olive_app
OLIVE_POSTGRES_PASSWORD=

# Required: JSONL file the simulated executor appends to (startup fails if unset or not writable). Keep it out of git.
OLIVE_EXECUTOR_OUTPUT_PATH=.olive-data/executions.jsonl

# Optional: trace verification timeout in milliseconds (default 5000; must be a positive integer).
# OLIVE_TRACE_TIMEOUT_MS=5000

# Optional: directory lookup timeout in milliseconds (default 5000; must be a positive integer).
# OLIVE_DIRECTORY_TIMEOUT_MS=5000

# Shell-only, migrator command only (do not uncomment here):
# OLIVE_MIGRATOR_URL=
